# Copy this file to .env.local for local development, and add the same
# variables in your hosting provider's settings for production.

# Public URL of the site, no trailing slash. Used in SEO tags, the sitemap and share images.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# --- Contact form email delivery (https://resend.com) ---
# Without these, the form logs submissions in development and shows an
# "email us directly" message in production.
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate for several). Leave empty to use the site email,
# vscodeslabs@gmail.com (set in src/data/site.ts).
CONTACT_TO_EMAIL=
# Sender address on a domain you've verified in Resend.
CONTACT_FROM_EMAIL="Website <website@yourdomain.com>"
